{
  "name": "ib-prep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate-content": "node scripts/validate-content.mjs",
    "check-examples": "node scripts/check-examples.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --mac dir --arm64",
    "electron:dist": "npm run build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.51.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "main": "electron/main.mjs",
  "description": "Offline investment-banking study app",
  "author": "IB Prep",
  "build": {
    "appId": "com.ibprep.app",
    "productName": "IB Prep",
    "executableName": "IB Prep",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "IB Prep",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": null
  },
  "dependencies": {}
}
