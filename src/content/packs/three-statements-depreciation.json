      "steps": [
        {
          "id": "step-01",
          "title": "Depreciation rises by $10m",
          "text": "Depreciation is an operating expense, so the extra $10m raises it from $50.0m to $60.0m and total operating expenses from $250.0m to $260.0m.",
          "rows": [
            "r-is-dep"
          ],
          "connections": [
            {
              "from": "r-is-dep",
              "to": "r-is-opex",
              "label": "Feeds total operating expenses"
            }
          ]
        },
        {
          "id": "step-02",
          "title": "Operating income and pre-tax income fall by $10m",
          "text": "Higher operating expenses reduce operating income (EBIT) by $10m to $340.0m. Interest is unchanged, so pre-tax income also falls by $10m to $300.0m.",
          "rows": [
            "r-is-opex",
            "r-is-ebit",
            "r-is-ebt"
          ],
          "connections": [
            {
              "from": "r-is-opex",
              "to": "r-is-ebit",
              "label": "Opex up, EBIT down"
            },
            {
              "from": "r-is-ebit",
              "to": "r-is-ebt",
              "label": "Interest unchanged"
            }
          ]
        },
        {
          "id": "step-03",
          "title": "Taxes fall by $2.5m, so net income falls by $7.5m",
          "text": "At a 25% tax rate on $300.0m of pre-tax income, tax expense is $75.0m, down $2.5m. Net income therefore falls by $10m less $2.5m, which is $7.5m, to $225.0m.",
          "rows": [
            "r-is-ebt",
            "r-is-tax",
            "r-is-ni"
          ],
          "connections": [
            {
              "from": "r-is-ebt",
              "to": "r-is-tax",
              "label": "25% of pre-tax income"
            },
            {
              "from": "r-is-tax",
              "to": "r-is-ni",
              "label": "Lower tax cushions the fall"
            }
          ]
        },
        {
          "id": "step-04",
          "title": "Both changes reach the cash flow statement",
          "text": "Cash flow from operations starts with net income, now $225.0m. Depreciation is a non-cash expense, so the full $60.0m is added back.",
          "rows": [
            "r-cf-ni",
            "r-cf-dep"
          ],
          "connections": [
            {
              "from": "r-is-ni",
              "to": "r-cf-ni",
              "label": "Starting point"
            },
            {
              "from": "r-is-dep",
              "to": "r-cf-dep",
              "label": "Non-cash add-back"
            }
          ]
        },
        {
          "id": "step-05",
          "title": "Cash from operations rises by $2.5m",
          "text": "Net income is down $7.5m but the add-back is up $10m, so cash flow from operations rises by $2.5m to $270.0m. That is exactly the tax saving. Investing and financing are unchanged.",
          "rows": [
            "r-cf-ni",
            "r-cf-dep",
            "r-cf-cfo"
          ],
          "connections": [
            {
              "from": "r-cf-ni",
              "to": "r-cf-cfo",
              "label": "Down $7.5m"
            },
            {
              "from": "r-cf-dep",
              "to": "r-cf-cfo",
              "label": "Up $10m"
            }
          ]
        },
        {
          "id": "step-06",
          "title": "Net change in cash and ending cash rise by $2.5m",
          "text": "With investing (-$80.0m) and financing (-$90.0m) unchanged, the net change in cash is $100.0m. Added to $100.0m of opening cash, ending cash is $200.0m.",
          "rows": [
            "r-cf-cfo",
            "r-cf-net",
            "r-cf-end"
          ],
          "connections": [
            {
              "from": "r-cf-cfo",
              "to": "r-cf-net",
              "label": "Plus unchanged investing and financing"
            },
            {
              "from": "r-cf-net",
              "to": "r-cf-end",
              "label": "Plus opening cash"
            }
          ]
        },
        {
          "id": "step-07",
          "title": "Ending cash links to the balance sheet",
          "text": "Cash on the balance sheet must equal ending cash on the cash flow statement, so it rises by $2.5m to $200.0m. Current assets rise to $410.0m.",
          "rows": [
            "r-bs-cash",
            "r-bs-tca"
          ],
          "connections": [
            {
              "from": "r-cf-end",
              "to": "r-bs-cash",
              "label": "Cash reconciles"
            },
            {
              "from": "r-bs-cash",
              "to": "r-bs-tca",
              "label": "Feeds current assets"
            }
          ]
        },
        {
          "id": "step-08",
          "title": "PP&E falls by the $10m of extra depreciation",
          "text": "Depreciation reduces the book value of property, plant and equipment, so PP&E falls by $10m to $590.0m. Total assets fall by $7.5m: cash is up $2.5m and PP&E is down $10m, giving $1,000.0m.",
          "rows": [
            "r-bs-ppe",
            "r-bs-tca",
            "r-bs-ta"
          ],
          "connections": [
            {
              "from": "r-is-dep",
              "to": "r-bs-ppe",
              "label": "Lowers book value"
            },
            {
              "from": "r-bs-ppe",
              "to": "r-bs-ta",
              "label": "Down $10m"
            },
            {
              "from": "r-bs-tca",
              "to": "r-bs-ta",
              "label": "Up $2.5m"
            }
          ]
        },
        {
          "id": "step-09",
          "title": "Retained earnings absorb the $7.5m fall in net income",
          "text": "Retained earnings accumulate net income less dividends. Dividends are fixed, so retained earnings fall by $7.5m to $320.0m, and total equity falls to $520.0m.",
          "rows": [
            "r-is-ni",
            "r-bs-re",
            "r-bs-te"
          ],
          "connections": [
            {
              "from": "r-is-ni",
              "to": "r-bs-re",
              "label": "Net income accumulates"
            },
            {
              "from": "r-bs-re",
              "to": "r-bs-te",
              "label": "Feeds total equity"
            }
          ]
        },
        {
          "id": "step-10",
          "title": "The balance sheet balances again",
          "text": "Liabilities are unchanged at $480.0m and equity is $520.0m, so total liabilities and equity are $1,000.0m, matching total assets of $1,000.0m.",
          "rows": [
            "r-bs-ta",
            "r-bs-tl",
            "r-bs-te",
            "r-bs-tle"
          ],
          "connections": [
            {
              "from": "r-bs-te",
              "to": "r-bs-tle",
              "label": "Plus liabilities of $480.0m"
            },
            {
              "from": "r-bs-ta",
              "to": "r-bs-tle",
              "label": "Assets = liabilities + equity"
            }
          ]
        }
      ]
    }
  ]
