  "title": "Three statements: depreciation",
  "description": "One complete three-statement exercise: a $10m increase in depreciation with explicit tax assumptions.",
  "concepts": [
    {
      "id": "c-retained-earnings",
      "name": "Retained earnings",
      "summary": "Cumulative net income less dividends. It links the income statement to shareholders' equity on the balance sheet."
    },
    {
      "id": "c-cash-reconciliation",
      "name": "Cash reconciliation",
      "summary": "Ending cash on the cash flow statement must equal cash on the balance sheet, which is what ties the three statements together."
    }
  ],
  "threeStatementExercises": [
    {
      "id": "ts-depreciation-001",
      "category": "Accounting",
      "subcategory": "Three statements",
      "title": "Depreciation rises by $10m",
      "instructions": [
        "Depreciation expense turns out to be $10m higher than the figures shown. Update the income statement, cash flow statement and balance sheet for this change.",
        "Each statement shows the original figures beside editable figures that start with the same values. Change every figure that is affected, including subtotals and totals, and leave the others alone. Then submit to see how you did."
      ],
      "assumptions": [
        {
          "label": "Change",
          "value": "Depreciation expense is $10m higher than originally recorded"
        },
        {
          "label": "Tax rate",
          "value": "25% of pre-tax income"
        },
        {
          "label": "Tax treatment",
          "value": "The extra depreciation is tax-deductible, and income tax is paid in cash in the same period (no deferred taxes)"
        },
        {
          "label": "Working capital and capex",
          "value": "Unchanged"
        },
        {
          "label": "Interest and financing",
          "value": "Unchanged; no new debt or equity is raised"
        },
        {
          "label": "Dividends",
          "value": "Fixed at $40m, so they do not change"
        }
      ],
      "units": "$m",
      "decimals": 1,
      "tolerance": 0.05,
      "conceptIds": [
        "c-three-statements",
        "c-non-cash-charges",
        "c-tax-shield",
        "c-retained-earnings",
        "c-cash-reconciliation"
